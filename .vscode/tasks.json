{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "ui:dev",
      "command": "pnpm",
      "args": ["run", "start"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building\\.\\.\\.",
          "endsPattern": "Application bundle generation complete|Local:"
        }
      }
    }
  ]
}
