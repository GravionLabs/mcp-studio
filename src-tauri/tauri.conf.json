{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCP Studio",
  "mainBinaryName": "mcp-studio",
  "version": "0.1.0",
  "identifier": "dev.gravionlabs.mcp-studio",
  "build": {
    "beforeDevCommand": "pnpm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist/mcp-studio/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MCP Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "media-src": "'self' data: blob:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Postman for MCP",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
